meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "testuser",
    "password": "password123",
    "email": "test@example.com"
  }
}

vars:pre-request {
  baseUrl: https://kitek.ktkv.dev/marketplace
}

